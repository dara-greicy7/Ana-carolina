<?xml version="1.0" encoding="utf-8"?>
<element type="mediapro" group="ZOOlanders" zlfw="3.1.12">
	<name>Media Pro</name>
	<author>ZOOlanders</author>
	<creationDate>April 2012</creationDate>
	<copyright>Copyright (C) JOOlanders, SL</copyright>
	<authorEmail>info@zoolanders.com</authorEmail>
	<authorUrl>http://www.zoolanders.com</authorUrl>
	<version>3.3.4</version>
	<description>Advanced Media Element</description>
	<params>
		<param name="layout" type="zlfield" label="PLG_ZLFRAMEWORK_EDIT_LAYOUT" addctrl="layout" toggle="true">
			<loadfield type="layout">
				<layout label="PLG_ZLFRAMEWORK_MAIN_LAYOUT" help="PLG_ZLFRAMEWORK_MAIN_LAYOUT_DESC" path="elements:mediapro/tmpl/edit" default="default.php" />
			</loadfield>
		</param>
		<param name="specific" type="zlfield" label="PLG_ZLFRAMEWORK_SPECIFIC" addctrl="specific">
			<loadfield type="loadjson">
				<load path="elements:mediapro/params/config.php" />
			</loadfield>
		</param>
		<param name="files" type="zlfield" label="PLG_ZLFRAMEWORK_FILES" addctrl="files">
			<loadfield type="files">
				<s3 enabled="true" />
			</loadfield>
		</param>
	</params>
	<params group="render">
		<param name="layout" type="zlfield" label="PLG_ZLFRAMEWORK_LAYOUT" addctrl="layout" toggle="true">
			<loadfield type="loadjson">
				<load label="PLG_ZLFRAMEWORK_MAIN_LAYOUT" help="PLG_ZLFRAMEWORK_MAIN_LAYOUT_DESC" path="elements:mediapro/mplayout.json.php" />
			</loadfield>
		</param>
		<param name="separator" type="zlfield" label="PLG_ZLFRAMEWORK_SP_SEPARATOR" addctrl="separator" toggle="true">
			<loadfield type="separator" />
		</param>
	</params>
	<params group="submission">
		<param name="layout" type="zlfield" label="PLG_ZLFRAMEWORK_LAYOUT" addctrl="layout" toggle="true">
			<loadfield type="layout">
				<layout label="PLG_ZLFRAMEWORK_MAIN_LAYOUT" help="PLG_ZLFRAMEWORK_MAIN_LAYOUT_DESC" path="elements:mediapro/tmpl/submission" default="default.php" />
			</loadfield>
		</param>
	</params>
</element>
